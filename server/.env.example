# Nex-Chat — Variáveis de ambiente do servidor
# Copie este arquivo para .env e preencha os valores

# Token Bearer para autenticação das rotas /api/*
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Secret para validar webhooks da Evolution API
WEBHOOK_SECRET=

# Secret para assinar tokens JWT (mínimo 64 bytes hex)
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Expiração das sessões JWT (ex: 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# URL do webhook Make/Zapier para notificar vendas (opcional)
MAKE_WEBHOOK_URL=
